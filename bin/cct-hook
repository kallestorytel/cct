#!/usr/bin/env bash
# Claude Code hook. Records session state for the cct menu bar plugin.
# Usage (from settings.json): cct-hook <start|prompt|tool|notify|stop|end>
set -euo pipefail

# Only Ghostty tabs can be focused. Sessions in other terminals (VS Code, iTerm, …) are ignored.
# Hooks inherit Claude Code's environment, which inherits it from the terminal.
[ "${TERM_PROGRAM:-}" = "ghostty" ] || exit 0

STATE_DIR="${CCT_STATE_DIR:-$HOME/.cct/sessions}"
mkdir -p "$STATE_DIR"
# Claude Code ignores stderr from async hooks, so keep it somewhere we can read it.
exec 2>>"$STATE_DIR/../hook.log"

event="${1:?usage: cct-hook <start|prompt|tool|notify|stop|end>}"
input="$(cat)"
session_id="$(jq -r '.session_id // empty' <<<"$input")"
[ -n "$session_id" ] || { echo "cct-hook: no session_id in hook input" >&2; exit 1; }
state_file="$STATE_DIR/$session_id.json"
now="$(date +%s)"

# Hooks run without a controlling TTY. Walk up to the nearest ancestor that has one: the claude process.
find_claude_process() {
  local pid=$PPID tty
  while [ "$pid" -gt 1 ]; do
    tty="$(ps -o tty= -p "$pid" | tr -d ' ')"
    if [ -n "$tty" ] && [ "$tty" != "??" ]; then
      echo "$pid /dev/$tty"
      return
    fi
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
  done
  echo "cct-hook: no ancestor with a TTY found" >&2
  return 1
}

# Merge a jq expression into the state file atomically.
update_state() {
  local current='{}'
  [ -f "$state_file" ] && current="$(cat "$state_file")"
  jq --argjson now "$now" "$@" <<<"$current" > "$state_file.tmp"
  mv "$state_file.tmp" "$state_file"
}

current_status() {
  [ -f "$state_file" ] && jq -r '.status // empty' "$state_file" || true
}

record_identity() {
  local found pid tty
  found="$(find_claude_process)" || exit 1
  read -r pid tty <<<"$found"
  update_state --arg sid "$session_id" --arg cwd "$(jq -r --arg pwd "$PWD" '.cwd // $pwd' <<<"$input")" \
    --argjson pid "$pid" --arg tty "$tty" \
    '. + {session_id: $sid, cwd: $cwd, pid: $pid, tty: $tty, updated: $now}'
}

has_identity() {
  [ -f "$state_file" ] && jq -e '.pid and .cwd and .tty' "$state_file" > /dev/null
}

# Sessions started before the hooks were installed never ran "start", and any event can come first.
if [ "$event" != "end" ] && ! has_identity; then
  record_identity
fi

case "$event" in
  start)
    update_state '. + {status: "idle"}'
    ;;
  prompt)
    update_state --arg prompt "$(jq -r '.prompt // ""' <<<"$input" | tr '\n' ' ' | cut -c1-60)" \
      '. + {status: "busy", prompt: $prompt, updated: $now}'
    ;;
  tool)
    # A tool ran, so Claude is working: it answered a permission prompt, or a turn started without
    # a prompt (monitor event, background task). Only write when it changes something.
    [ "$(current_status)" != "busy" ] && update_state '. + {status: "busy", updated: $now}'
    ;;
  notify)
    case "$(jq -r '.notification_type // empty' <<<"$input")" in
      permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input)
        update_state '. + {status: "waiting", updated: $now}' ;;
      idle_prompt)
        # Fires after Claude has waited a while. Catches interrupted turns where Stop never fired.
        [ "$(current_status)" = "busy" ] && update_state '. + {status: "done", updated: $now}' ;;
    esac
    ;;
  stop)
    update_state '. + {status: "done", updated: $now}'
    ;;
  end)
    rm -f "$state_file"
    ;;
  *)
    echo "cct-hook: unknown event '$event'" >&2
    exit 1
    ;;
esac
exit 0
